{
  "manifest_version": 3,
  "name": "SpachBob",
  "version": "1.0",
  "description": "This extension is made for moodle to answer the quizes just by pressing 'special keys' keys on your keyboard.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://betamoodle.iiitvadodara.ac.in/*",
        "https://sandbox.moodledemo.net/*"
      ],
      "js": ["config.js", "service.js", "content.js"]
    },
    {
      "matches": [
        "https://docs.google.com/forms/*"
      ],
      "js": ["config.js", "service.js", "google-form.js"]
    }
  ]
}
