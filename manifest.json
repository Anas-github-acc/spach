{
  "manifest_version": 3,
  "name": "Dark Reader",
  "version": "2.3",
  "description": "Dark mode for Moodle and Google Forms with a clean, eye-friendly interface",
  "icons": {
    "16": "logo/darkreader.png",
    "48": "logo/darkreader.png",
    "128": "logo/darkreader.png"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://betamoodle.iiitvadodara.ac.in/*",
        "https://sandbox.moodledemo.net/*"
      ],
      "js": ["config.js", "service.js", "ai-config.js", "content.js"]
    },
    {
      "matches": [
        "https://docs.google.com/forms/*"
      ],
      "js": ["config.js", "service.js", "ai-config.js", "google-form.js"]
    }
  ]
}
