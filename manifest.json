{
  "manifest_version": 3,
  "name": "SpachBob",
  "version": "1.0",
  "description": "This extension is made for moodle to answer the quizes just by pressing 'special keys' keys on your keyboard.",
  
  "host_permissions": [
    "https://generativelanguage.googleapis.com/"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/*",
        "https://betamoodle.iiitvadodara.ac.in/*"
      ],
      "js": ["content.js", "google-form.js"]
    }
  ]
}
